# ---- Bridge ----
UPLINK_BUF_FRAMES=100
DOWNLINK_BUF_FRAMES=200
LOG_LEVEL=INFO

# ---- SIP ----
SIP_DOMAIN=0.0.0.0
SIP_TRANSPORT_TYPE=udp
SIP_PORT=5060

# ---- Agent ----
AI_VENDOR=inworld
AGENT_PROMPT_FILE=agent_prompt.yaml

# ---- Inworld Realtime ----
INWORLD_API_KEY=
INWORLD_WS_ENDPOINT=wss://api.inworld.ai/api/v1/realtime/session
INWORLD_MODEL=google/gemini-3.1-flash-lite
INWORLD_VOICE=default-gir-n2kfw-hbdko0a0q9lw__nadine-neu
INWORLD_TTS_MODEL=inworld-tts-2
INWORLD_STT_MODEL=inworld-stt-1
INWORLD_VAD_THRESHOLD=0.62
INWORLD_MIN_END_OF_TURN_SILENCE=500
INWORLD_END_OF_TURN_CONFIDENCE=0.75
OPENAI_AUDIO_FORMAT=pcmu          # pcmu = G.711 μ-law durchreichen (Telefonie)

